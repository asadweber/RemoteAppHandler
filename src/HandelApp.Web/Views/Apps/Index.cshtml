@model HandelApp.Web.Models.AppsViewModel
@{
    ViewData["Title"] = "Registered Apps";
}

@* Full-page blocking overlay *@
<div id="action-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; flex-direction:column; gap:12px;">
    <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span id="overlay-label" class="text-white fw-semibold fs-5"></span>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Registered Apps</h2>
        <span class="badge @(Model.IsConnectedToAgent ? "bg-success" : "bg-danger") fs-6">
            Agent: @(Model.IsConnectedToAgent ? "Connected" : "Disconnected")
        </span>
    </div>

    @if (Model.ResultMessage is not null)
    {
        <div class="alert @(Model.IsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.ResultMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header fw-semibold">Register New App</div>
        <div class="card-body">
            <form asp-controller="Apps" asp-action="Register" method="post" data-action-label="Registering app…">
                @Html.AntiForgeryToken()
                <div class="row g-2 mb-2">
                    <div class="col-md-2">
                        <input name="AppId" class="form-control" placeholder="app-id (slug)" required />
                    </div>
                    <div class="col-md-2">
                        <input name="DisplayName" class="form-control" placeholder="Display Name" required />
                    </div>
                    <div class="col-md-3">
                        <input name="DefaultInstancePath" class="form-control" placeholder="Default path (e.g. C:\Apps\MyApp\Default)" required />
                    </div>
                    <div class="col-md-3">
                        <input name="InstancesRootPath" class="form-control" placeholder="Instances root (e.g. C:\Apps\MyApp)" required />
                    </div>
                    <div class="col-md-2">
                        <input name="ExecutableName" class="form-control" placeholder="Exe (e.g. App.exe)" required />
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-md-2">
                        <input name="InstanceNamePrefix" class="form-control" value="Instance" placeholder="Prefix" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary"
                                @(!Model.IsConnectedToAgent ? "disabled" : "")>
                            Register
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Apps.Count == 0)
    {
        <div class="alert alert-info">No apps registered yet. Use the form above to register one.</div>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>App ID</th>
                    <th>Display Name</th>
                    <th>Default Path</th>
                    <th>Instances Root</th>
                    <th>Exe</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Apps)
                {
                    <tr>
                        <td><code>@app.AppId</code></td>
                        <td><strong>@app.DisplayName</strong></td>
                        <td><code>@app.DefaultInstancePath</code></td>
                        <td><code>@app.InstancesRootPath</code></td>
                        <td><code>@app.ExecutableName</code></td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="/HandelApp/@app.AppId"
                                   class="btn btn-outline-primary">
                                    Manage
                                </a>

                                <form asp-controller="Apps"
                                      asp-action="Unregister"
                                      asp-route-appId="@app.AppId"
                                      method="post"
                                      class="d-inline"
                                      data-action-label="Unregistering @app.AppId…"
                                      data-confirm="Unregister @app.DisplayName? All instance management will stop.">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger"
                                            disabled="@(!Model.IsConnectedToAgent)">
                                        Unregister
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
<script>
(function () {
    var overlay = document.getElementById('action-overlay');
    var label   = document.getElementById('overlay-label');

    function showOverlay(message) {
        label.textContent = message;
        overlay.style.display = 'flex';
        document.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
    }

    document.querySelectorAll('form[data-action-label]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            var confirmMsg = form.dataset.confirm;
            if (confirmMsg && !confirm(confirmMsg)) { e.preventDefault(); return; }
            showOverlay(form.dataset.actionLabel);
        });
    });
}());
</script>
}
