@model HandelApp.Web.Models.InstancesViewModel
@{
    ViewData["Title"] = "App Instances";
    var appId = ViewBag.AppId as string ?? string.Empty;
}

@* Full-page blocking overlay shown during any form submission *@
<div id="action-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; flex-direction:column; gap:12px;">
    <div class="spinner-border text-light" style="width:3rem; height:3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span id="overlay-label" class="text-white fw-semibold fs-5"></span>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/Apps" class="text-decoration-none text-muted small">&larr; All Apps</a>
            <h2 class="mb-0">@appId — Instances</h2>
        </div>
        <span id="agent-badge" class="badge @(Model.IsConnectedToAgent ? "bg-success" : "bg-danger") fs-6">
            Agent: @(Model.IsConnectedToAgent ? "Connected" : "Disconnected")
        </span>
    </div>

    @if (Model.ResultMessage is not null)
    {
        <div class="alert @(Model.IsError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.ResultMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <form asp-action="Create" asp-route-appId="@appId" method="post" data-action-label="Creating new instance…">
            @Html.AntiForgeryToken()
            <button id="btn-create" type="submit" class="btn btn-primary"
                    @(!Model.IsConnectedToAgent ? "disabled" : "")>
                + Add New Instance
            </button>
        </form>
    </div>

    @if (Model.Instances.Count == 0)
    {
        <div class="alert alert-info">No instances found. Click "Add New Instance" to get started.</div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Instance</th>
                    <th>Folder</th>
                    <th>Status</th>
                    <th>PID</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="instances-tbody">
                @foreach (var inst in Model.Instances)
                {
                    var num = inst.InstanceName.Split('-').LastOrDefault();
                    <tr data-instance="@inst.InstanceName" data-is-default="@inst.IsDefault.ToString().ToLower()">
                        <td>
                            <strong>@inst.InstanceName</strong>
                            @if (inst.IsDefault)
                            {
                                <span class="badge bg-info ms-1">Default</span>
                            }
                        </td>
                        <td><code>@inst.FolderPath</code></td>
                        <td data-status>
                            @if (inst.IsRunning)
                            {
                                <span class="badge bg-success">Running</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Stopped</span>
                            }
                        </td>
                        <td data-pid>@(inst.ProcessId?.ToString() ?? "-")</td>
                        <td class="d-flex gap-1">
                            <form asp-action="Start" asp-route-appId="@appId" asp-route-name="@inst.InstanceName"
                                  method="post" data-action-label="Starting @inst.InstanceName…">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success" data-btn="start"
                                        @(inst.IsRunning || !Model.IsConnectedToAgent ? "disabled" : "")>
                                    Start
                                </button>
                            </form>
                            <form asp-action="Stop" asp-route-appId="@appId" asp-route-name="@inst.InstanceName"
                                  method="post" data-action-label="Stopping @inst.InstanceName…">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-warning" data-btn="stop"
                                        @(!inst.IsRunning || !Model.IsConnectedToAgent ? "disabled" : "")>
                                    Stop
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-appId="@appId" asp-route-number="@num"
                                  method="post"
                                  data-action-label="Deleting @inst.InstanceName…"
                                  data-confirm="Delete @inst.InstanceName?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" data-btn="delete"
                                        @(inst.IsDefault || inst.IsRunning || !Model.IsConnectedToAgent ? "disabled" : "")>
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
<script>
(function () {
    var overlay   = document.getElementById('action-overlay');
    var label     = document.getElementById('overlay-label');
    var busy      = false;
    var INTERVAL  = 5000;
    var appId     = '@appId';

    function showOverlay(message) {
        busy = true;
        label.textContent = message;
        overlay.style.display = 'flex';
        document.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
    }

    document.querySelectorAll('form[data-action-label]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            var confirmMsg = form.dataset.confirm;
            if (confirmMsg && !confirm(confirmMsg)) { e.preventDefault(); return; }
            showOverlay(form.dataset.actionLabel);
        });
    });

    function updateRow(inst, connected) {
        var row = document.querySelector('tr[data-instance="' + inst.instanceName + '"]');
        if (!row) return;

        var isDefault = row.dataset.isDefault === 'true';

        var statusCell = row.querySelector('[data-status]');
        if (statusCell) {
            var badge = statusCell.querySelector('.badge') || document.createElement('span');
            badge.className   = inst.isRunning ? 'badge bg-success' : 'badge bg-secondary';
            badge.textContent = inst.isRunning ? 'Running' : 'Stopped';
            if (!statusCell.contains(badge)) statusCell.appendChild(badge);
        }

        var pidCell = row.querySelector('[data-pid]');
        if (pidCell) pidCell.textContent = inst.processId != null ? inst.processId : '-';

        var btnStart  = row.querySelector('[data-btn="start"]');
        var btnStop   = row.querySelector('[data-btn="stop"]');
        var btnDelete = row.querySelector('[data-btn="delete"]');

        if (btnStart)  btnStart.disabled  = inst.isRunning || !connected;
        if (btnStop)   btnStop.disabled   = !inst.isRunning || !connected;
        if (btnDelete) btnDelete.disabled = isDefault || inst.isRunning || !connected;
    }

    function updateAgentBadge(connected) {
        var badge = document.getElementById('agent-badge');
        if (!badge) return;
        badge.className = 'badge fs-6 ' + (connected ? 'bg-success' : 'bg-danger');
        badge.textContent = 'Agent: ' + (connected ? 'Connected' : 'Disconnected');

        var btnCreate = document.getElementById('btn-create');
        if (btnCreate) btnCreate.disabled = !connected;
    }

    function poll() {
        if (busy) return;
        fetch('/ConsoleApp/' + appId + '/StatusJson')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data || busy) return;
                updateAgentBadge(data.connected);
                (data.instances || []).forEach(function (inst) {
                    updateRow(inst, data.connected);
                });
            })
            .catch(function () { /* network error — skip tick */ });
    }

    setInterval(poll, INTERVAL);
}());
</script>
}
